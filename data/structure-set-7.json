    {
      "id": "S7-001",
      "type": "sentence-completion",
      "topic": "Subjunctive mood",
      "question": "The judge ordered that the defendant _____ in court tomorrow.",
      "choices": [
        "will appear",
        "appears",
        "appear",
        "appeared"
      ],
      "answer": 2,
      "explanation": "Subjunctive base form after 'ordered that'."
    },
    {
      "id": "S7-002",
      "type": "sentence-completion",
      "topic": "Subject-verb agreement",
      "question": "Neither the manager nor the employees _____ responsible for the delay.",
      "choices": [
        "have been",
        "is",
        "was",
        "were"
      ],
      "answer": 0,
      "explanation": "Nearest subject 'employees' is plural, requiring plural verb 'have been'."
    },
    {
      "id": "S7-003",
      "type": "sentence-completion",
      "topic": "Parallel structure",
      "question": "She enjoys reading, swimming, and _____ long walks.",
      "choices": [
        "taken",
        "to take",
        "take",
        "taking"
      ],
      "answer": 3,
      "explanation": "Parallel gerunds require 'taking'."
    },
    {
      "id": "S7-004",
      "type": "sentence-completion",
      "topic": "Passive voice",
      "question": "The new bridge _____ last year and opened to traffic in spring.",
      "choices": [
        "completing",
        "was completed",
        "has complete",
        "completed"
      ],
      "answer": 1,
      "explanation": "Passive past 'was completed' fits timeline."
    },
    {
      "id": "S7-005",
      "type": "sentence-completion",
      "topic": "Inversion with hardly",
      "question": "Hardly _____ the lecture begun when the fire alarm rang.",
      "choices": [
        "having",
        "had",
        "has",
        "have"
      ],
      "answer": 1,
      "explanation": "'Hardly...when' takes past perfect 'had'."
    },
    {
      "id": "S7-006",
      "type": "sentence-completion",
      "topic": "Relative clause",
      "question": "The city _____ I grew up has changed dramatically.",
      "choices": [
        "in which",
        "that in",
        "which",
        "where"
      ],
      "answer": 0,
      "explanation": "'In which' correctly pairs preposition with relative pronoun."
    },
    {
      "id": "S7-007",
      "type": "sentence-completion",
      "topic": "Conditional type 3",
      "question": "If he _____ harder, he would have passed the bar exam.",
      "choices": [
        "studied",
        "has studied",
        "would study",
        "had studied"
      ],
      "answer": 3,
      "explanation": "Type 3 conditional needs past perfect in if-clause."
    },
    {
      "id": "S7-008",
